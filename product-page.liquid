{% assign product = product %}
{% assign current_variant = product.selected_or_first_available_variant %}

<style>
  :root {
    --pp-gold: #f5a623;
    --pp-dark: #1a1a1a;
    --pp-accent: #e94560;
    --pp-green: #27ae60;
    --pp-text: #1a1a1a;
    --pp-muted: #666;
    --pp-bg: #fff;
    --pp-light: #f8f8f8;
    --pp-border: #e5e5e5;
  }

  /* ── URGENCY BAR ── */
  .pp-urgency-bar {
    background: var(--pp-accent);
    color: #fff;
    text-align: center;
    padding: 10px 20px;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.5px;
  }
  .pp-urgency-bar span { font-weight: 900; }

  /* ── ABOVE THE FOLD ── */
  .pp-atf {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }
  @media (max-width: 768px) {
    .pp-atf { grid-template-columns: 1fr; gap: 30px; padding: 20px; }
  }

  /* Gallery */
  .pp-gallery { position: sticky; top: 20px; }
  .pp-main-img {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: var(--pp-light);
    aspect-ratio: 1;
    display: flex; align-items: center; justify-content: center;
  }
  .pp-main-img img { width: 100%; height: 100%; object-fit: cover; }
  .pp-thumbs {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .pp-thumb {
    width: 72px; height: 72px;
    border-radius: 8px;
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer;
    background: var(--pp-light);
  }
  .pp-thumb.active { border-color: var(--pp-gold); }
  .pp-thumb img { width: 100%; height: 100%; object-fit: cover; }

  /* Buy Box */
  .pp-buybox { display: flex; flex-direction: column; gap: 20px; }

  .pp-social-proof {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .pp-stars { color: var(--pp-gold); font-size: 1.1rem; letter-spacing: 1px; }
  .pp-review-count { font-size: 0.88rem; color: var(--pp-muted); text-decoration: underline; cursor: pointer; }
  .pp-buyers { font-size: 0.82rem; font-weight: 700; color: var(--pp-green); background: #e8f8ee; padding: 3px 10px; border-radius: 20px; }

  .pp-title { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 900; line-height: 1.2; color: var(--pp-text); }

  .pp-subtitle { font-size: 1rem; color: var(--pp-muted); margin-top: 4px; }

  .pp-price-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .pp-price-old { text-decoration: line-through; color: var(--pp-muted); font-size: 1.1rem; }
  .pp-price-now { font-size: 2rem; font-weight: 900; color: var(--pp-accent); }
  .pp-discount-tag {
    background: var(--pp-accent);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 20px;
  }

  .pp-bullets { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .pp-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.95rem;
    color: var(--pp-text);
  }
  .pp-bullets li::before { content: '✓'; color: var(--pp-green); font-weight: 900; flex-shrink: 0; margin-top: 1px; }

  /* Volume pricing */
  .pp-volume { display: flex; flex-direction: column; gap: 10px; }
  .pp-volume-label { font-size: 0.82rem; font-weight: 700; color: var(--pp-muted); text-transform: uppercase; letter-spacing: 1px; }
  .pp-volume-options { display: flex; gap: 10px; flex-wrap: wrap; }
  .pp-vol-btn {
    flex: 1;
    min-width: 100px;
    border: 2px solid var(--pp-border);
    border-radius: 12px;
    padding: 12px 8px;
    text-align: center;
    cursor: pointer;
    background: var(--pp-bg);
    transition: border-color .15s;
    position: relative;
  }
  .pp-vol-btn.active { border-color: var(--pp-gold); background: #fffbf0; }
  .pp-vol-btn .qty { font-size: 0.82rem; color: var(--pp-muted); }
  .pp-vol-btn .vol-price { font-size: 1.1rem; font-weight: 800; color: var(--pp-text); }
  .pp-vol-btn .vol-save { font-size: 0.72rem; font-weight: 700; color: var(--pp-green); }
  .pp-vol-best {
    position: absolute;
    top: -10px; left: 50%;
    transform: translateX(-50%);
    background: var(--pp-gold);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 2px 10px;
    border-radius: 10px;
    white-space: nowrap;
  }

  /* ATC Button */
  .pp-atc {
    background: linear-gradient(135deg, var(--pp-gold), #e67e22);
    color: #fff;
    border: none;
    border-radius: 50px;
    padding: 18px 32px;
    font-size: 1.15rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    width: 100%;
    box-shadow: 0 6px 24px rgba(245,166,35,0.4);
    transition: transform .15s, box-shadow .15s;
  }
  .pp-atc:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(245,166,35,0.5); }

  .pp-shipping-note { font-size: 0.85rem; color: var(--pp-muted); text-align: center; }

  /* Trust badges */
  .pp-badges { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; padding: 16px 0; border-top: 1px solid var(--pp-border); border-bottom: 1px solid var(--pp-border); }
  .pp-badge { display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 0.75rem; font-weight: 700; color: var(--pp-muted); text-align: center; }
  .pp-badge span:first-child { font-size: 1.4rem; }

  /* ── SECTIONS SHARED ── */
  .pp-section { max-width: 900px; margin: 0 auto; padding: 60px 20px; }
  .pp-section-title {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 900;
    text-align: center;
    margin-bottom: 40px;
    color: var(--pp-text);
  }
  .pp-section-title span { color: var(--pp-gold); }
  .pp-divider { border: none; border-top: 1px solid var(--pp-border); margin: 0; }

  /* ── TRANSFORMACION ── */
  .pp-steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; }
  .pp-step-card {
    background: var(--pp-light);
    border-radius: 16px;
    padding: 28px 24px;
    text-align: center;
    border: 1px solid var(--pp-border);
  }
  .pp-step-num {
    width: 48px; height: 48px;
    background: linear-gradient(135deg, var(--pp-gold), #e67e22);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.3rem; font-weight: 900; color: #fff;
    margin: 0 auto 16px;
  }
  .pp-step-card h3 { font-size: 1rem; font-weight: 800; color: var(--pp-text); margin-bottom: 8px; }
  .pp-step-card p { font-size: 0.88rem; color: var(--pp-muted); line-height: 1.5; }

  .pp-before-after {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 16px;
    align-items: center;
    margin-top: 40px;
    background: var(--pp-light);
    border-radius: 16px;
    padding: 24px;
  }
  .pp-ba-side { text-align: center; }
  .pp-ba-side img { width: 100%; max-width: 200px; border-radius: 12px; }
  .pp-ba-label { font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-top: 8px; }
  .pp-ba-label.before { color: var(--pp-muted); }
  .pp-ba-label.after { color: var(--pp-green); }
  .pp-ba-arrow { font-size: 2rem; color: var(--pp-gold); font-weight: 900; }

  /* ── INTERES ── */
  .pp-mechanism {
    background: #fffbf0;
    border-left: 4px solid var(--pp-gold);
    border-radius: 0 12px 12px 0;
    padding: 24px 28px;
    margin-bottom: 40px;
  }
  .pp-mechanism h3 { font-size: 1rem; font-weight: 800; color: var(--pp-gold); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1px; }
  .pp-mechanism p { font-size: 0.95rem; color: var(--pp-text); line-height: 1.6; }

  .pp-benefits-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
  .pp-benefit {
    background: var(--pp-light);
    border-radius: 14px;
    padding: 24px 20px;
    border: 1px solid var(--pp-border);
  }
  .pp-benefit .icon { font-size: 1.8rem; margin-bottom: 10px; }
  .pp-benefit h4 { font-size: 0.95rem; font-weight: 800; color: var(--pp-text); margin-bottom: 6px; }
  .pp-benefit p { font-size: 0.82rem; color: var(--pp-muted); line-height: 1.4; }

  /* Comparison table */
  .pp-compare { width: 100%; border-collapse: collapse; margin-top: 40px; font-size: 0.88rem; }
  .pp-compare th {
    padding: 14px 16px;
    text-align: center;
    font-weight: 800;
    background: var(--pp-light);
    border: 1px solid var(--pp-border);
  }
  .pp-compare th.highlight { background: var(--pp-gold); color: #fff; }
  .pp-compare td {
    padding: 12px 16px;
    text-align: center;
    border: 1px solid var(--pp-border);
    color: var(--pp-text);
  }
  .pp-compare tr:nth-child(even) td { background: var(--pp-light); }
  .pp-compare td.highlight { background: #fffbf0; font-weight: 700; }
  .pp-yes { color: var(--pp-green); font-size: 1.1rem; font-weight: 900; }
  .pp-no { color: #ccc; font-size: 1.1rem; }

  /* ── DESEO / TESTIMONIOS ── */
  .pp-hero-review {
    background: var(--pp-light);
    border-radius: 20px;
    padding: 32px;
    display: flex;
    gap: 24px;
    align-items: flex-start;
    margin-bottom: 30px;
    border: 1px solid var(--pp-border);
  }
  .pp-reviewer-photo {
    width: 72px; height: 72px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--pp-gold), #e67e22);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.8rem;
    color: #fff;
    font-weight: 900;
  }
  .pp-review-stars { color: var(--pp-gold); font-size: 1rem; margin-bottom: 6px; }
  .pp-review-text { font-size: 0.98rem; color: var(--pp-text); line-height: 1.6; font-style: italic; margin-bottom: 10px; }
  .pp-reviewer-name { font-size: 0.85rem; font-weight: 700; color: var(--pp-muted); }
  .pp-verified { color: var(--pp-green); font-size: 0.78rem; font-weight: 700; }

  .pp-reviews-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .pp-review-card {
    background: var(--pp-light);
    border-radius: 14px;
    padding: 20px;
    border: 1px solid var(--pp-border);
  }
  .pp-review-card .pp-review-stars { font-size: 0.9rem; }
  .pp-review-card .pp-review-text { font-size: 0.88rem; margin-bottom: 10px; }
  .pp-review-card .pp-reviewer-name { font-size: 0.8rem; }

  .pp-review-summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    background: var(--pp-light);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 30px;
    flex-wrap: wrap;
  }
  .pp-big-score { font-size: 3rem; font-weight: 900; color: var(--pp-text); }
  .pp-score-detail { display: flex; flex-direction: column; gap: 2px; }
  .pp-score-stars { color: var(--pp-gold); font-size: 1.3rem; }
  .pp-score-count { font-size: 0.82rem; color: var(--pp-muted); }

  /* ── FAQ ── */
  .pp-faq { display: flex; flex-direction: column; gap: 0; }
  .pp-faq-item { border-bottom: 1px solid var(--pp-border); }
  .pp-faq-q {
    width: 100%;
    background: none;
    border: none;
    padding: 20px 0;
    text-align: left;
    font-size: 1rem;
    font-weight: 700;
    color: var(--pp-text);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .pp-faq-q .chevron { font-size: 1.2rem; color: var(--pp-gold); transition: transform .2s; flex-shrink: 0; }
  .pp-faq-q.open .chevron { transform: rotate(180deg); }
  .pp-faq-a {
    font-size: 0.92rem;
    color: var(--pp-muted);
    line-height: 1.7;
    max-height: 0;
    overflow: hidden;
    transition: max-height .3s ease, padding .3s;
  }
  .pp-faq-a.open { max-height: 400px; padding-bottom: 20px; }

  /* ── CTA FINAL ── */
  .pp-final-cta {
    background: linear-gradient(135deg, #1a1a2e, #302b63);
    color: #fff;
    text-align: center;
    padding: 60px 20px;
  }
  .pp-final-cta h2 { font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 900; margin-bottom: 8px; }
  .pp-final-cta h2 span { color: var(--pp-gold); }
  .pp-final-cta p { font-size: 0.95rem; color: rgba(255,255,255,0.7); max-width: 500px; margin: 0 auto 24px; }
  .pp-final-price-old { text-decoration: line-through; color: rgba(255,255,255,0.4); font-size: 1rem; }
  .pp-final-price-now { font-size: 2.5rem; font-weight: 900; color: var(--pp-gold); margin: 8px 0 24px; }
  .pp-final-badges { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; margin-top: 20px; font-size: 0.82rem; color: rgba(255,255,255,0.6); }

  /* ── STICKY ATC ── */
  .pp-sticky {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: #fff;
    border-top: 1px solid var(--pp-border);
    padding: 12px 20px;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.1);
    transform: translateY(100%);
    transition: transform .3s;
  }
  .pp-sticky.visible { transform: translateY(0); }
  .pp-sticky-info { display: flex; flex-direction: column; gap: 2px; }
  .pp-sticky-name { font-size: 0.88rem; font-weight: 700; color: var(--pp-text); }
  .pp-sticky-price { font-size: 1.1rem; font-weight: 900; color: var(--pp-accent); }
  .pp-sticky-btn {
    background: linear-gradient(135deg, var(--pp-gold), #e67e22);
    color: #fff;
    border: none;
    border-radius: 50px;
    padding: 12px 28px;
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .pp-sticky-info { display: none; }
    .pp-sticky-btn { width: 100%; padding: 14px; font-size: 1rem; }
  }
</style>

<!-- ════════════════════════════════════
     BARRA DE URGENCIA
     ════════════════════════════════════ -->
<div class="pp-urgency-bar">
  🔥 OFERTA ESPECIAL — 30% DESCUENTO · Quedan <span id="pp-stock">47</span> unidades · Envío rápido garantizado
</div>

<!-- ════════════════════════════════════
     SECCIÓN 1: ABOVE THE FOLD
     ════════════════════════════════════ -->
<div class="pp-atf">

  <!-- GALERÍA -->
  <div class="pp-gallery">
    <div class="pp-main-img" id="pp-main-img">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.title }}" id="pp-featured-img">
      {%- else -%}
        <span style="font-size:5rem;">🌅</span>
      {%- endif -%}
    </div>
    <div class="pp-thumbs">
      {%- for image in product.images limit: 5 -%}
        <div class="pp-thumb {% if forloop.first %}active{% endif %}" onclick="ppSetImage('{{ image | img_url: '800x' }}', this)">
          <img src="{{ image | img_url: '150x' }}" alt="">
        </div>
      {%- endfor -%}
    </div>
  </div>

  <!-- BUY BOX -->
  <div class="pp-buybox">

    <!-- Prueba social -->
    <div class="pp-social-proof">
      <span class="pp-stars">★★★★★</span>
      <span class="pp-review-count">+2,800 reviews</span>
      <span class="pp-buyers">✓ Más de 5,000 clientes</span>
    </div>

    <!-- Nombre y subtítulo -->
    <h1 class="pp-title">{{ product.title }}</h1>
    <p class="pp-subtitle">Transforma cualquier habitación en un refugio cálido en menos de 60 segundos</p>

    <!-- Precio -->
    <div class="pp-price-row">
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <span class="pp-price-old">{{ current_variant.compare_at_price | money }}</span>
      {%- endif -%}
      <span class="pp-price-now">{{ current_variant.price | money }}</span>
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <span class="pp-discount-tag">
          -{{ current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price }}% OFF
        </span>
      {%- endif -%}
    </div>

    <!-- Bullets rápidos -->
    <ul class="pp-bullets">
      <li>Ambiente de atardecer real en menos de 60 segundos</li>
      <li>Cabezal giratorio 180° — ilumina pared, techo o suelo</li>
      <li>LED de bajo consumo — hasta 25,000 horas de vida útil</li>
      <li>Sin instalación — solo enchufa y disfruta</li>
    </ul>

    <!-- Volumen / Combos -->
    <div class="pp-volume">
      <div class="pp-volume-label">Elige tu pack:</div>
      <div class="pp-volume-options">
        <div class="pp-vol-btn" onclick="ppSelectVol(this, '{{ section.settings.variant_1x }}')" data-variant="{{ section.settings.variant_1x }}">
          <div class="qty">1 unidad</div>
          <div class="vol-price">{{ section.settings.price_1x }}</div>
        </div>
        <div class="pp-vol-btn active" onclick="ppSelectVol(this, '{{ section.settings.variant_2x }}')" data-variant="{{ section.settings.variant_2x }}">
          <span class="pp-vol-best">⭐ POPULAR</span>
          <div class="qty">2 unidades</div>
          <div class="vol-price">{{ section.settings.price_2x }}</div>
          <div class="vol-save">Ahorra {{ section.settings.save_2x }}</div>
        </div>
        <div class="pp-vol-btn" onclick="ppSelectVol(this, '{{ section.settings.variant_3x }}')" data-variant="{{ section.settings.variant_3x }}">
          <div class="qty">3 unidades</div>
          <div class="vol-price">{{ section.settings.price_3x }}</div>
          <div class="vol-save">Ahorra {{ section.settings.save_3x }}</div>
        </div>
      </div>
    </div>

    <!-- ATC -->
    <form action="/cart/add" method="post" id="pp-form">
      <input type="hidden" name="id" id="pp-variant-id" value="{{ current_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="pp-atc" id="pp-atc-btn">
        🛒 AGREGAR AL CARRITO — {{ current_variant.price | money }}
      </button>
    </form>

    <!-- Envío -->
    <p class="pp-shipping-note">📦 Envío en 3–5 días hábiles · Tracking incluido</p>

    <!-- Trust Badges -->
    <div class="pp-badges">
      <div class="pp-badge"><span>🛡️</span><span>Garantía<br>30 días</span></div>
      <div class="pp-badge"><span>📦</span><span>Envío<br>gratis</span></div>
      <div class="pp-badge"><span>↩️</span><span>Devolución<br>sin preguntas</span></div>
      <div class="pp-badge"><span>🔒</span><span>Pago<br>seguro</span></div>
    </div>

  </div>
</div>

<hr class="pp-divider">

<!-- ════════════════════════════════════
     SECCIÓN 2: TRANSFORMACIÓN
     ════════════════════════════════════ -->
<section class="pp-section">
  <h2 class="pp-section-title">
    Ambiente de ensueño garantizado<br><span>en 3 simples pasos</span>
  </h2>
  <div class="pp-steps">
    <div class="pp-step-card">
      <div class="pp-step-num">1</div>
      <h3>ENCHUFA</h3>
      <p>Sin instalación, sin herramientas. Conéctalo a cualquier enchufe estándar y enciéndelo. Listo en segundos.</p>
    </div>
    <div class="pp-step-card">
      <div class="pp-step-num">2</div>
      <h3>ORIENTA</h3>
      <p>Gira el cabezal 180° para dirigir la luz al techo, pared o suelo. A mayor distancia, mayor el halo dorado.</p>
    </div>
    <div class="pp-step-card">
      <div class="pp-step-num">3</div>
      <h3>DISFRUTA</h3>
      <p>Tu habitación se transforma en un refugio cálido y acogedor. Tu cerebro entra en modo relajación de inmediato.</p>
    </div>
  </div>

  <div class="pp-before-after">
    <div class="pp-ba-side">
      <div style="width:100%;height:160px;background:linear-gradient(135deg,#ddd,#bbb);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:2rem;">💡</div>
      <div class="pp-ba-label before">ANTES — Luz fría genérica</div>
    </div>
    <div class="pp-ba-arrow">→</div>
    <div class="pp-ba-side">
      <div style="width:100%;height:160px;background:linear-gradient(135deg,#f5a623,#e67e22);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:2rem;">🌅</div>
      <div class="pp-ba-label after">DESPUÉS — Ambiente de atardecer</div>
    </div>
  </div>
</section>

<hr class="pp-divider">

<!-- ════════════════════════════════════
     SECCIÓN 3: INTERÉS
