<div class="pp-sticky" id="pp-sticky">
  <div class="pp-sticky-info">
    <div class="pp-sticky-name">{{ product.title }}</div>
    <div class="pp-sticky-price">{{ current_variant.price | money }}</div>
  </div>
  <form action="/cart/add" method="post">
    <input type="hidden" name="id" value="{{ current_variant.id }}">
    <input type="hidden" name="quantity" value="1">
    <button type="submit" class="pp-sticky-btn">🛒 AGREGAR AL CARRITO</button>
  </form>
</div>

<script>
  // Gallery
  function ppSetImage(src, el) {
    document.getElementById('pp-featured-img') && (document.getElementById('pp-featured-img').src = src);
    document.querySelectorAll('.pp-thumb').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
  }

  // Volume selector
  var ppSelectedVariant = '{{ current_variant.id }}';
  function ppSelectVol(el, variantId) {
    document.querySelectorAll('.pp-vol-btn').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    if (variantId) {
      ppSelectedVariant = variantId;
      document.getElementById('pp-variant-id') && (document.getElementById('pp-variant-id').value = variantId);
    }
  }

  // FAQ accordion
  function ppToggleFaq(btn) {
    var answer = btn.nextElementSibling;
    var isOpen = answer.classList.contains('open');
    document.querySelectorAll('.pp-faq-a').forEach(a => a.classList.remove('open'));
    document.querySelectorAll('.pp-faq-q').forEach(b => b.classList.remove('open'));
    if (!isOpen) { answer.classList.add('open'); btn.classList.add('open'); }
  }

  // Sticky ATC
  var ppAtcBtn = document.getElementById('pp-atc-btn');
  var ppSticky = document.getElementById('pp-sticky');
  if (ppAtcBtn && ppSticky) {
    var ppObserver = new IntersectionObserver(function(entries) {
      entries[0].isIntersecting ? ppSticky.classList.remove('visible') : ppSticky.classList.add('visible');
    }, { threshold: 0.1 });
    ppObserver.observe(ppAtcBtn);
  }

  // Stock countdown
  (function() {
    var el = document.getElementById('pp-stock');
    if (!el) return;
    var n = 47;
    setInterval(function() {
      if (Math.random() < 0.15 && n > 5) { n--; el.textContent = n; }
    }, 9000);
  })();
</script>

