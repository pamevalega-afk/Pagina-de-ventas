    <strong>Oferta válida para las primeras 100 personas.</strong>
  </p>
  <a href="{{ section.settings.product_url }}" class="sg-cta-btn">¡SÍ, QUIERO MI SUNGLOW PRO AHORA!</a>
  <p class="sg-cta-sub" style="margin-top:16px;">🔒 Pago seguro · 📦 Envío en 3–5 días · 🛡️ Garantía 110% sin preguntas</p>
</div>

<script>
  (function () {
    var end = new Date().getTime() + 23 * 3600 * 1000 + 47 * 60 * 1000 + 12 * 1000;
    var el = document.getElementById('sg-timer');
    function update() {
      var diff = end - new Date().getTime();
      if (diff <= 0) { el.textContent = '00:00:00'; return; }
      var h = String(Math.floor(diff / 3600000)).padStart(2, '0');
      var m = String(Math.floor((diff % 3600000) / 60000)).padStart(2, '0');
      var s = String(Math.floor((diff % 60000) / 1000)).padStart(2, '0');
      el.textContent = h + ':' + m + ':' + s;
    }
    update();
    setInterval(update, 1000);
  })();

  (function () {
    var el = document.getElementById('sg-stock');
    var n = 47;
    setInterval(function () {
      if (Math.random() < 0.15 && n > 5) { n--; el.textContent = n; }
    }, 8000);
  })();
</script>

