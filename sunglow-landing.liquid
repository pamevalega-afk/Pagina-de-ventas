{{ 'sunglow-landing.css' | asset_url | stylesheet_tag }}

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --gold: #f5a623;
    --dark: #1a1a2e;
    --mid: #16213e;
    --accent: #e94560;
    --text: #f0f0f0;
    --muted: #b0b0c0;
    --green: #27ae60;
  }

  body {
    font-family: 'Segoe UI', system-ui, sans-serif;
    background: var(--dark);
    color: var(--text);
    line-height: 1.6;
  }

  .sg-hero {
    background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
    padding: 60px 20px 80px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .sg-hero::before {
    content: '';
    position: absolute;
    top: -60px; left: 50%;
    transform: translateX(-50%);
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(245,166,35,0.25) 0%, transparent 70%);
    pointer-events: none;
  }
  .sg-badge {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 6px 18px;
    border-radius: 40px;
    margin-bottom: 20px;
  }
  .sg-hero h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 900;
    line-height: 1.15;
    max-width: 780px;
    margin: 0 auto 20px;
    color: var(--text);
  }
  .sg-hero h1 span { color: var(--gold); }
  .sg-hero p.sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--muted);
    max-width: 620px;
    margin: 0 auto 36px;
  }
  .sg-product-img {
    width: 100%;
    max-width: 420px;
    border-radius: 20px;
    margin: 0 auto 40px;
    display: block;
    box-shadow: 0 0 80px rgba(245,166,35,0.4);
  }
  .sg-cta-btn {
    display: inline-block;
    background: linear-gradient(135deg, var(--gold), #e67e22);
    color: #fff !important;
    font-size: 1.2rem;
    font-weight: 800;
    padding: 18px 48px;
    border-radius: 50px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 8px 30px rgba(245,166,35,0.5);
    transition: transform .15s, box-shadow .15s;
    border: none;
    cursor: pointer;
  }
  .sg-cta-btn:hover { transform: translateY(-3px); box-shadow: 0 12px 40px rgba(245,166,35,0.6); }
  .sg-cta-sub { font-size: 0.82rem; color: var(--muted); margin-top: 12px; }

  .sg-section { padding: 70px 20px; max-width: 860px; margin: 0 auto; }
  .sg-section h2 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 800;
    margin-bottom: 24px;
    line-height: 1.2;
    color: var(--text);
  }
  .sg-section h2 span { color: var(--gold); }

  .sg-bg-mid { background: var(--mid); padding: 2px 0; }

  .sg-problem ul { list-style: none; margin-top: 20px; }
  .sg-problem ul li {
    padding: 12px 0 12px 36px;
    position: relative;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    font-size: 1.05rem;
    color: var(--text);
  }
  .sg-problem ul li::before { content: '✗'; position: absolute; left: 0; color: var(--accent); font-weight: 700; font-size: 1.1rem; }

  .sg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    margin-top: 30px;
  }
  .sg-card {
    background: var(--mid);
    border-radius: 16px;
    padding: 28px 24px;
    border: 1px solid rgba(245,166,35,0.15);
  }
  .sg-card .icon { font-size: 2rem; margin-bottom: 12px; }
  .sg-card h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 8px; color: var(--gold); }
  .sg-card p { font-size: 0.92rem; color: var(--muted); }

  .sg-steps { counter-reset: step; }
  .sg-step { display: flex; gap: 24px; align-items: flex-start; margin-bottom: 32px; }
  .sg-step-num {
    counter-increment: step;
    min-width: 52px; height: 52px;
    background: linear-gradient(135deg, var(--gold), #e67e22);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.3rem; font-weight: 900; color: #fff;
    flex-shrink: 0;
  }
  .sg-step-num::after { content: counter(step); }
  .sg-step-body h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 6px; color: var(--text); }
  .sg-step-body p { font-size: 0.95rem; color: var(--muted); }

  .sg-pricing-wrap { background: var(--mid); border-radius: 20px; padding: 50px 24px; }
  .sg-pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-top: 30px;
  }
  .sg-price-card {
    background: var(--dark);
    border-radius: 16px;
    padding: 30px 20px;
    text-align: center;
    border: 2px solid rgba(255,255,255,0.08);
    position: relative;
  }
  .sg-price-card.popular { border-color: var(--gold); transform: scale(1.04); }
  .sg-popular-tag {
    position: absolute;
    top: -14px; left: 50%;
    transform: translateX(-50%);
    background: var(--gold);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 16px;
    border-radius: 20px;
    white-space: nowrap;
  }
  .sg-price-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 16px; color: var(--muted); }
  .sg-price-old { text-decoration: line-through; color: var(--muted); font-size: 0.9rem; }
  .sg-price-now { font-size: 2.2rem; font-weight: 900; color: var(--gold); }
  .sg-price-unit { font-size: 0.78rem; color: var(--muted); margin-bottom: 16px; }
  .sg-price-perks { list-style: none; text-align: left; font-size: 0.88rem; margin-bottom: 24px; color: var(--text); }
  .sg-price-perks li { padding: 6px 0 6px 22px; position: relative; }
  .sg-price-perks li::before { content: '✓'; position: absolute; left: 0; color: var(--green); font-weight: 700; }

  .sg-guarantee {
    background: linear-gradient(135deg, rgba(39,174,96,0.12), rgba(39,174,96,0.04));
    border: 1px solid rgba(39,174,96,0.3);
    border-radius: 20px;
    padding: 40px 30px;
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }
  .sg-guarantee .shield { font-size: 3rem; flex-shrink: 0; }
  .sg-guarantee h3 { font-size: 1.3rem; font-weight: 800; color: #2ecc71; margin-bottom: 10px; }
  .sg-guarantee p { font-size: 0.95rem; color: var(--muted); }

  .sg-testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 30px;
  }
  .sg-testimonial {
    background: var(--mid);
    border-radius: 16px;
    padding: 24px;
    border-left: 3px solid var(--gold);
  }
  .sg-stars { color: var(--gold); font-size: 1.1rem; margin-bottom: 10px; }
  .sg-testimonial p { font-size: 0.92rem; color: var(--muted); margin-bottom: 14px; font-style: italic; }
  .sg-testimonial .author { font-size: 0.85rem; font-weight: 700; color: var(--text); }

  .sg-bonus-box {
    background: linear-gradient(135deg, rgba(245,166,35,0.1), rgba(245,166,35,0.03));
    border: 1px solid rgba(245,166,35,0.3);
    border-radius: 16px;
    padding: 28px 24px;
    margin-bottom: 20px;
    display: flex;
    gap: 20px;
    align-items: center;
  }
  .sg-bonus-icon { font-size: 2.2rem; flex-shrink: 0; }
  .sg-bonus-box h4 { font-size: 1rem; font-weight: 700; color: var(--gold); margin-bottom: 4px; }
  .sg-bonus-box p { font-size: 0.88rem; color: var(--muted); }
  .sg-bonus-value { font-size: 0.8rem; color: var(--accent); font-weight: 700; }

  .sg-urgency {
    background: linear-gradient(135deg, rgba(233,69,96,0.12), rgba(233,69,96,0.04));
    border: 1px solid rgba(233,69,96,0.3);
    border-radius: 16px;
    padding: 28px 24px;
    text-align: center;
  }
  .sg-urgency h3 { color: var(--accent); font-size: 1.2rem; font-weight: 800; margin-bottom: 10px; }
  .sg-urgency p { color: var(--muted); font-size: 0.95rem; }
  .sg-countdown { font-size: 2rem; font-weight: 900; color: var(--accent); letter-spacing: 3px; margin: 12px 0; }

  .sg-final-cta {
    background: linear-gradient(135deg, #0f0c29, #302b63);
    padding: 80px 20px;
    text-align: center;
  }
  .sg-final-cta h2 { margin-bottom: 16px; color: var(--text); }
  .sg-final-cta p { color: var(--muted); max-width: 520px; margin: 0 auto 36px; }

  .sg-top-bar {
    background: var(--accent);
    text-align: center;
    padding: 10px 20px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #fff;
  }

  @media (max-width: 600px) {
    .sg-guarantee { flex-direction: column; }
    .sg-price-card.popular { transform: none; }
    .sg-bonus-box { flex-direction: column; gap: 10px; }
  }
</style>

<!-- TOP BAR -->
<div class="sg-top-bar">
  🔥 OFERTA ESPECIAL — 30% DE DESCUENTO para las primeras 100 unidades · Quedan <span id="sg-stock">47</span> disponibles
</div>

<!-- HERO -->
<section class="sg-hero">
  <div class="sg-badge">✨ Nueva Colección 2025</div>
  <h1>
    Convierte tu habitación en un refugio<br>
    <span>de luz y calma en menos de 60 segundos</span>
  </h1>
  <p class="sub">
    Sin reformas. Sin electricistas. Sin estrés.
    Solo enchufa el <strong>{{ section.settings.product_name }}</strong> y siente ese ambiente cálido y acogedor
    que siempre quisiste para tu hogar.
  </p>

  {%- if section.settings.product_image != blank -%}
    <img
      src="{{ section.settings.product_image | img_url: '600x' }}"
      alt="{{ section.settings.product_name }}"
      class="sg-product-img"
      loading="eager"
    >
  {%- else -%}
    <div style="width:100%;max-width:420px;height:320px;background:linear-gradient(135deg,#302b63,#f5a62320);border-radius:20px;margin:0 auto 40px;display:flex;align-items:center;justify-content:center;font-size:4rem;box-shadow:0 0 80px rgba(245,166,35,0.4);">🌅</div>
  {%- endif -%}

  <a href="{{ section.settings.product_url }}" class="sg-cta-btn">¡QUIERO MI SUNGLOW PRO CON 30% OFF!</a>
  <p class="sg-cta-sub">🔒 Pago 100% seguro · Envío rápido · Garantía de 30 días</p>
</section>

<!-- PROBLEMA -->
<div class="sg-bg-mid">
  <div class="sg-section sg-problem">
    <h2>¿Reconoces esta sensación?</h2>
    <p style="color:var(--muted);">No es culpa tuya. La iluminación fría y genérica de tu hogar está diseñada para fábricas, no para personas.</p>
    <ul>
      <li>Llegas a casa agotado y la luz blanca te activa en lugar de relajarte</li>
      <li>Tu sala parece una oficina en vez de un hogar acogedor</li>
      <li>Las velas son románticas pero peligrosas y duran poco</li>
      <li>Cambiar la instalación eléctrica cuesta cientos de euros y semanas de obras</li>
      <li>Ya compraste lámparas baratas que rompieron o daban una luz horrible</li>
    </ul>
  </div>
</div>

<!-- MECANISMO DE LA SOLUCIÓN -->
<section class="sg-section">
  <h2>El secreto: luz que <span>imita el atardecer</span></h2>
  <p style="color:var(--muted); margin-bottom:30px;">
    El SunGlow Pro utiliza un sistema de proyección LED de espectro cálido que replica exactamente los tonos anaranjados y dorados de la puesta de sol.
    Cuando tu cerebro percibe esa luz, activa de forma automática el modo relajación.
    No es magia — es biología. Y funciona en el primer segundo.
  </p>
  <div class="sg-grid">
    <div class="sg-card"><div class="icon">🌅</div><h3>Ambiente de atardecer instantáneo</h3><p>Proyecta halos cálidos que transforman cualquier pared o techo en una escena serena. Tu cerebro se relaja de inmediato.</p></div>
    <div class="sg-card"><div class="icon">🔄</div><h3>Giro 180° totalmente ajustable</h3><p>Dirige la luz donde quieras — pared, techo, suelo — y regula el tamaño del halo con un simple giro. Total control.</p></div>
    <div class="sg-card"><div class="icon">💡</div><h3>LED de bajo consumo y larga vida</h3><p>Hasta 25.000 horas de uso. No quema, no parpadea, no molesta los ojos. Un gasto mínimo en luz para años de disfrute.</p></div>
    <div class="sg-card"><div class="icon">🏠</div><h3>Multifuncional y versátil</h3><p>Habitación, sala, cuarto infantil, fiestas, transmisiones en vivo. Un solo producto, mil ambientes.</p></div>
    <div class="sg-card"><div class="icon">⚡</div><h3>Listo en menos de 60 segundos</h3><p>Sin instalación, sin herramientas, sin manual de 20 páginas. Enchufa, orienta y disfruta.</p></div>
    <div class="sg-card"><div class="icon">🛡️</div><h3>Aluminio resistente y base estable</h3><p>Fabricada con materiales premium. Se queda donde la pones, aguanta el día a día y mantiene su elegancia por años.</p></div>
  </div>
</section>

<!-- CÓMO FUNCIONA -->
<div class="sg-bg-mid">
  <section class="sg-section">
    <h2>Transforma tu hogar <span>en 3 pasos</span></h2>
    <div class="sg-steps">
      <div class="sg-step">
        <div class="sg-step-num"></div>
        <div class="sg-step-body"><h3>Enchufa el SunGlow Pro</h3><p>Sin instalación. Conéctalo al enchufe de siempre. No necesitas electricista ni herramientas.</p></div>
      </div>
      <div class="sg-step">
        <div class="sg-step-num"></div>
        <div class="sg-step-body"><h3>Orienta el cabezal giratorio</h3><p>Gira 180° para dirigir la luz al techo, pared o suelo. A mayor distancia, mayor el halo dorado que llena tu espacio.</p></div>
      </div>
      <div class="sg-step">
        <div class="sg-step-num"></div>
        <div class="sg-step-body"><h3>Disfruta el ambiente de tus sueños</h3><p>En menos de 60 segundos tendrás una habitación completamente transformada. Cálida, acogedora, tuya.</p></div>
      </div>
    </div>
  </section>
</div>

<!-- PRUEBA SOCIAL -->
<section class="sg-section">
  <h2>Más de <span>2.800 hogares</span> ya transformados</h2>
  <div class="sg-testimonials-grid">
    <div class="sg-testimonial">
      <div class="sg-stars">★★★★★</div>
      <p>"Llevaba años buscando algo así. En cuanto la encendí, mi marido y yo nos miramos y dijimos: 'por fin nuestra sala parece un hogar'. La compramos hace 3 meses y no la apagamos nunca."</p>
      <div class="author">— María G., Madrid</div>
    </div>
    <div class="sg-testimonial">
      <div class="sg-stars">★★★★★</div>
      <p>"La uso cada noche para hacer yoga y meditar. La luz cálida crea exactamente el ambiente que necesito. Mucho mejor que cualquier vela y sin el riesgo de incendio."</p>
      <div class="author">— Laura P., Barcelona</div>
    </div>
    <div class="sg-testimonial">
      <div class="sg-stars">★★★★★</div>
      <p>"Se la regalé a mi madre y me llamó emocionada. Dice que su cuarto parece ahora un spa de lujo. El precio por el ambiente que da es ridículo."</p>
      <div class="author">— Carlos M., Valencia</div>
    </div>
  </div>
</section>

<!-- BONUS -->
